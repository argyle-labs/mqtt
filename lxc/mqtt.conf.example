# Proxmox LXC config for Mosquitto MQTT — /etc/pve/lxc/<vmid>.conf
#
# Service: Eclipse Mosquitto MQTT broker
# Ports:   1883 (MQTT), 9001 (MQTT over WebSockets)
#
# Right-sized as captured from a live host: 1 core / 256 MB RAM / 2 GB disk.
# Mosquitto is tiny — do not oversize it.

arch: amd64
cores: 1
memory: 256
swap: 512
hostname: mqtt
ostype: debian
unprivileged: 1
onboot: 1
features: nesting=1,keyctl=1
rootfs: local-lvm:vm-<vmid>-disk-0,size=2G

# Network — replace with your LAN addressing (or use ip=dhcp).
# hwaddr is auto-assigned by Proxmox on create; do not hard-code one.
net0: name=eth0,bridge=vmbr0,ip=10.0.0.71/24,gw=10.0.0.1,ip6=dhcp,type=veth

timezone: America/Adak
tags: community-script;mqtt
